<?xml version="1.0" encoding="utf-8"?>
<component type="desktop-application">
    <id>com.ayugram.desktop</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0-or-later WITH OpenSSL-exception</project_license>
    <name>AyuGram Desktop</name>
    <summary>Telegram client with Ghost mode and anti-recall</summary>
    <summary xml:lang="ru">Клиент Telegram с режимом призрака и антиудалением</summary>
    <developer id="one.ayugram">
        <name>Radolyn Labs</name>
    </developer>
    <description>
        <p>Unofficial Linux packages of AyuGram Desktop: Ghost mode, anti-recall and extra customization. Built for Linux Mint, Ubuntu, Debian, Arch Linux and other distributions.</p>
        <p xml:lang="ru">Неофициальные Linux-пакеты AyuGram Desktop: режим призрака, антиудаление и доп. оформление. Для Linux Mint, Ubuntu, Debian, Arch Linux и других дистрибутивов.</p>
    </description>
    <categories>
        <category>Network</category>
        <category>InstantMessaging</category>
    </categories>
    <url type="homepage">https://github.com/stillemptyNOW/AyuGram-For-Linux</url>
    <url type="vcs-browser">https://github.com/stillemptyNOW/AyuGram-For-Linux</url>
    <url type="bugtracker">https://github.com/stillemptyNOW/AyuGram-For-Linux/issues</url>
    <launchable type="desktop-id">com.ayugram.desktop.desktop</launchable>
    <provides>
        <binary>AyuGram</binary>
        <binary>ayugram</binary>
    </provides>
    <releases>
        <release version="@VERSION@" date="@DATE@">
            <description>
                <p>Linux packages of upstream AyuGram Desktop v@VERSION@.</p>
            </description>
        </release>
    </releases>
    <content_rating type="oars-1.1">
        <content_attribute id="social-chat">intense</content_attribute>
        <content_attribute id="social-audio">intense</content_attribute>
        <content_attribute id="social-contacts">intense</content_attribute>
        <content_attribute id="money-purchasing">intense</content_attribute>
    </content_rating>
</component>
